# AVI Controller Configuration
AVI_CONTROLLER_IP=192.168.1.100
AVI_USERNAME=admin
AVI_PASSWORD=your-secure-password
# Device identity sent to Kentik on every record (ip_address = AVI_CONTROLLER_IP).
AVI_DEVICE_NAME=avi-controller-01

# Optional collector behavior
# Skip TLS verification by default (matches current behavior). Set to false in production.
AVI_INSECURE_SKIP_VERIFY=true
# Tenant scoping mode: auto, header_uuid, header_name, query_uuid, query_name
AVI_TENANT_SCOPE_MODE=auto
# Optional tenant filters (comma-separated names)
# AVI_TENANT_ALLOWLIST=admin,tenant-blue
# AVI_TENANT_DENYLIST=tenant-sandbox
# Optional metric batching fallback for mixed metric groups
AVI_METRIC_BATCHING=true
# Optional request timeout controls (seconds)
AVI_REQUEST_TIMEOUT_SECONDS=15
AVI_TOTAL_TIMEOUT_SECONDS=50

# Kentik Configuration
KENTIK_API_ENDPOINT="https://grpc.api.kentik.com/kmetrics/v202207/metrics/api/v2/write?bucket=&org=&precision=ns"
KENTIK_API_TOKEN=your-kentik-api-token-here
KENTIK_API_EMAIL=your-kentik-email@company.com

# Environment Tags
ENVIRONMENT=production
LOCATION=datacenter-east
